<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/fondo"
    >

    <TextView
        android:id="@+id/tv_jugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:text="TÚ"
        android:textSize="25dp"
        app:layout_constraintStart_toStartOf="@+id/tv_titulo"
        app:layout_constraintTop_toBottomOf="@+id/tv_titulo" />

    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="PIEDRA · PAPEL · TIJERA"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.057"
        android:textColor="@color/texto1"
        />

    <TextView
        android:id="@+id/tv_CPU"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        android:text="CPU"
        android:textSize="25dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_titulo"
        app:layout_constraintTop_toBottomOf="@+id/tv_titulo" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/fondoOscuro"
        app:cardCornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_jugador"
        app:layout_constraintStart_toStartOf="@+id/tv_jugador"
        app:layout_constraintTop_toBottomOf="@+id/tv_jugador" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_tu"
                android:layout_height="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/piedra" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/fondoOscuro"
        app:cardCornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_CPU"
        app:layout_constraintStart_toStartOf="@+id/tv_CPU"
        app:layout_constraintTop_toBottomOf="@+id/tv_CPU" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_CPU"
                android:layout_width="0dp"
                android:layout_height="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="?android:attr/textSelectHandleLeft" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_tuEleccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Tu elección"
        android:textSize="17dp"
        app:layout_constraintEnd_toEndOf="@+id/cardView2"
        app:layout_constraintStart_toStartOf="@+id/cardView2"
        app:layout_constraintTop_toBottomOf="@+id/cardView2"
        android:textColor="@color/texto1"
        />

    <TextView
        android:id="@+id/tv_eleccionCPU"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Elección CPU"
        android:textSize="17dp"
        app:layout_constraintEnd_toEndOf="@+id/cardView"
        app:layout_constraintStart_toStartOf="@+id/cardView"
        app:layout_constraintTop_toBottomOf="@+id/cardView"
        android:textColor="@color/texto1"
        />

    <TextView
        android:id="@+id/tv_qnGana"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="350dp"
        android:text="¿Quien gana?"
        android:textColor="@color/black"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_piedra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/boton"
        android:text="PIEDRA"
        app:cornerRadius="7dp"
        app:layout_constraintEnd_toStartOf="@+id/bt_papel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_qnGana" />

    <Button
        android:id="@+id/bt_papel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/boton"
        android:text="PAPEL"
        app:cornerRadius="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/bt_piedra"
        app:layout_constraintEnd_toStartOf="@+id/bt_tijera"
        app:layout_constraintStart_toEndOf="@+id/bt_piedra"
        app:layout_constraintTop_toTopOf="@+id/bt_piedra" />

    <Button
        android:id="@+id/bt_tijera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="55dp"
        android:backgroundTint="@color/boton"
        android:text="TIJERA"
        app:cornerRadius="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/bt_papel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_papel"
        app:layout_constraintTop_toTopOf="@+id/bt_papel" />

    <Button
        android:id="@+id/bt_reiniciar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/boton"
        android:text="REINICIAR"
        app:cornerRadius="7dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_empates"
        app:layout_constraintHorizontal_bias="0.511"
        app:layout_constraintStart_toStartOf="@+id/tv_empates"
        app:layout_constraintTop_toBottomOf="@+id/tv_empates" />

    <TextView
        android:id="@+id/tv_puntTu"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="20dp"
        android:text="Tú: 0"
        app:layout_constraintEnd_toEndOf="@+id/bt_papel"
        app:layout_constraintStart_toStartOf="@+id/bt_papel"
        app:layout_constraintTop_toBottomOf="@+id/bt_papel" />

    <TextView
        android:id="@+id/tv_puntCPU"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="CPU: 0"
        app:layout_constraintEnd_toEndOf="@+id/tv_puntTu"
        app:layout_constraintStart_toStartOf="@+id/tv_puntTu"
        app:layout_constraintTop_toBottomOf="@+id/tv_puntTu" />

    <TextView
        android:id="@+id/tv_empates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Empates: 0"
        app:layout_constraintEnd_toEndOf="@+id/tv_puntCPU"
        app:layout_constraintStart_toStartOf="@+id/tv_puntCPU"
        app:layout_constraintTop_toBottomOf="@+id/tv_puntCPU" />

</androidx.constraintlayout.widget.ConstraintLayout>